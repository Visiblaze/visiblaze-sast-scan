# Pinned third-party artefacts for the Visiblaze SAST action.
#
# ── Why this file exists rather than a version string in action.yml ──
#
# The action downloads and EXECUTES Opengrep on a customer's runner, next to their source and
# whatever credentials that job holds. We are the security vendor in that transaction, so
# "fetch the latest release" is not available to us: it means whatever appears at a URL we do
# not control becomes code we told a customer to run. A pinned version plus a verified digest
# means an upstream compromise, a re-tagged release, or a MITM changes the digest and the job
# stops instead of executing.
#
# Keeping the pin in its own file, rather than inline, makes a version bump a reviewable
# one-file diff with the digest visibly changing alongside the URL — the two must never move
# independently.
#
# ── HOW TO POPULATE ──
#
# The Opengrep pins below were gathered and double-checked on 2026-08-24, against the release
# they name. Filling this file is what allows the action to run at all: publishing a pin is the
# act of telling a customer to execute that binary, so a value landing here is a decision, not a
# formality. The licence read that gated the first publication is recorded in PUBLISHING.md.
#
# The sentinel is `UNSET`. action.yml checks for it and fails closed, so the action cannot run
# with an unverified pin. Any pin reset to UNSET disables the action until it is filled again.
# To (re)populate:
#
#   1. Pick the Opengrep release to pin. Record the exact tag, not "latest".
#   2. Download each asset and compute its digest on a machine you trust:
#        curl -fsSL -o opengrep "<asset url>"
#        sha256sum opengrep
#      Cross-check against the digest or signature the upstream release publishes. If upstream
#      publishes neither, say so in the review — that is a fact about the dependency, and the
#      right response is a decision, not a shrug.
#   3. Replace UNSET with the real values. Do not reformat: action.yml sources this file with
#      `set -a`, so every line must stay a plain KEY=value with no spaces around `=`.
#   4. Verify the guard still works by reverting one value to UNSET and confirming the action
#      refuses to run.
#
# The scanner binary itself is NOT pinned here. It comes from our own release, and the action
# resolves it from SCANNER_VERSION plus the checksums.txt published in that same release, so
# there is one digest to trust and we generate it.

# Where our own scanner release lives. A full base URL rather than a derived one: the action is
# also run from an in-repo path during CI (uses: ./public/...), where github.action_repository is
# empty, so deriving it would work in the published case and silently break the case that proves
# the published case. See PUBLISHING.md.
SCANNER_BASE_URL=https://github.com/Visiblaze/visiblaze-sast-scan/releases/download

# The Opengrep release tag being pinned, e.g. v1.27.1. Recorded separately from the URLs so a
# mismatch between the tag and the assets is visible in review.
# 2026-09-28: the interfile ALPHA, deliberately. It is the only Opengrep build with --taint-interfile
# (cross-file taint), and the benchmark measured SQL-injection recall 54/95 -> 72/95 with it plus our
# engines. We are in test mode with no customers. Move back to a stable release that has interfile as
# soon as one exists. Signature verified locally with cosign 3.1.3 against the identity below.
OPENGREP_VERSION=v2.0.0-nopython-interfile.alpha.3

# Per-architecture download URL and SHA-256 of the downloaded file. Both arches are required:
# GitHub-hosted runners are amd64, but arm64 runners are common for self-hosted fleets and a
# missing digest there would otherwise be discovered as a failure in a customer's pipeline.
OPENGREP_URL_LINUX_AMD64=https://github.com/opengrep/opengrep/releases/download/v2.0.0-nopython-interfile.alpha.3/opengrep_linux_x86
OPENGREP_SHA256_LINUX_AMD64=c974a8d6918a49ae340fad22913b131d0e20d8cd6682e4890ef057f4e29d6184

OPENGREP_URL_LINUX_ARM64=https://github.com/opengrep/opengrep/releases/download/v2.0.0-nopython-interfile.alpha.3/opengrep_linux_aarch64
OPENGREP_SHA256_LINUX_ARM64=20fc71aeadf7b6b93688d445cb5e5119d14ea6c68b6a6bf57cfed4ed3f402e51

# Our own scanner release to fetch. A tag, never a branch and never "latest": the action is
# consumed at a pinned SHA, and a floating scanner version behind a pinned action would make the
# thing a customer pinned not actually determine what runs.
SCANNER_VERSION=v1.25.0
# Digests of the scanner archives, committed here rather than read from the release.
#
# The release's own checksums.txt defends against a corrupted download and not against a
# compromised release - whoever can replace the archive can replace the file that vouches for it.
# With these here, the action SHA a customer pins determines the scanner bytes that execute.
#
# Both MUST be updated whenever SCANNER_VERSION moves. The release workflow prints them, and the
# action refuses to run rather than falling back if the pin for its architecture is missing.
SCANNER_SHA256_LINUX_AMD64=7765132e90f2e7146edfe2a5aeed6d0d05ce4ce6cdcf33655cf87f08d86d5fd6
SCANNER_SHA256_LINUX_ARM64=f224f81788c8b2b3dd607cccaeff08e32b98c2958f64cdea6384d8bec9a2ff21

# ── Scanner release signing ──────────────────────────────────────────────────────
#
# Whether the pinned scanner release carries Sigstore bundles (<archive>.sigstore.json) signed by
# our release workflow. The release workflow sets it true when it publishes a signed release; the
# action then REQUIRES the bundle and verifies it against the identity below. false for releases
# made before signing existed: the digest above stays the only control for them.
SCANNER_SIGNED=true
# Any branch the release workflow was dispatched from, in our repository, and nothing else.
SCANNER_CERT_IDENTITY_REGEXP=^https://github[.]com/Visiblaze/visiblaze-IQ-Backend/[.]github/workflows/release-scanner[.]yml@refs/heads/.+$
SCANNER_CERT_OIDC_ISSUER=https://token.actions.githubusercontent.com

# The public key (base64 DER, ECDSA P-256) the platform signs served rule packs with. Empty: the
# scanner checks a fetched pack's digest only. Set: a fetched pack must carry a valid signature by
# this key, or the scanner uses the pack embedded in its own binary instead.
RULES_SIGNING_PUBKEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAETGI5kmDDRNQ63ZaBBFQiqSqNgTC3H15Ox4Oy+4D8cgYsDJMRM/xmaQFYUnNrq1LOd8GNzSu0gY6VdKXdao7hQQ==

# ── Cosign, used to verify Opengrep's signature ──
#
# Opengrep signs each release binary with Sigstore keyless signing (a .sig and .cert beside
# every asset). The SHA-256 pins above prove the bytes match what we recorded; the signature
# proves upstream actually published them. Both, because a digest we recorded in error is
# still a digest we would happily match forever.
#
# Cosign is itself a binary we download, so it is pinned the same way. The recursion stops
# here: these digests are the ones sigstore publishes in cosign_checksums.txt, not ones we
# computed from the same download.
COSIGN_VERSION=v3.1.3
COSIGN_URL_LINUX_AMD64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64
COSIGN_SHA256_LINUX_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
COSIGN_URL_LINUX_ARM64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-arm64
COSIGN_SHA256_LINUX_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a

# The identity Opengrep signs with. Pinning this is the whole point: `cosign verify-blob`
# without --certificate-identity accepts ANY valid Sigstore signature, including one an
# attacker minted for their own repository. Read out of the v1.27.1 certificate on
# 2026-08-24; re-check it when bumping OPENGREP_VERSION, because a project moving its
# release workflow changes this string and the verification must fail loudly if it does.
# The alpha is built by the same release workflow from the `interfile` branch, hence @refs/heads/interfile.
OPENGREP_CERT_IDENTITY=https://github.com/opengrep/opengrep/.github/workflows/rolling-release.yml@refs/heads/interfile
OPENGREP_CERT_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Origins this action may send findings to. Space separated, scheme and host only.
#
# Checked by the wrapper rather than by the scanner, so the guarantee - findings can only reach a
# Visiblaze endpoint - is one a reviewer can verify by reading this repository instead of trusting
# a compiled binary. Adding an origin is a visible diff in the commit a customer pins.
#
# An empty value is REFUSED at runtime, not treated as unrestricted: a truncated pins.env must not
# read as permission.
# MUST BE QUOTED once this holds more than one origin. pins.env is `source`d with `set -a`, so
# an unquoted `KEY=a b` parses as "run command `b` with KEY=a in its environment" — the shell
# variable is then never set, the allowlist reads EMPTY, and every origin is refused with a message
# blaming the caller's api-url. Verified 2026-09-08. The quotes are harmless with one value, so
# they are here now rather than added by whoever adds the second.
ALLOWED_API_ORIGINS="https://qwc3m6imgj.execute-api.ap-south-1.amazonaws.com"
